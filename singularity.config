// docker.config
// Конфигурация для запуска пайплайна с Docker-контейнерами (вместо Singularity)
//
// Использование:
//   nextflow run main.nf -profile local -c docker.config
//
// Этот файл переопределяет Singularity-настройки из nextflow.config
// и заменяет все .sif контейнеры на Docker-образы.


docker {
    enabled   = false
}
// Singularity/Apptainer — включён по умолчанию (для HPC и локального запуска)
singularity {
    enabled   = true
    autoMounts = true
}


// ============================================================================
// Docker-образы для каждого процесса
// ============================================================================
//
// Для кастомных контейнеров (отмечены *) нужно предварительно собрать
// Docker-образы из containers/def/ и запушить в реестр.
// Пример:
//   cd containers/def
//   docker build -f bwa-picard.def -t tb-lite/bwa-picard:3.4.0 .
//   docker push tb-lite/bwa-picard:3.4.0
//
// Пока кастомные образы не собраны, можно собрать их локально:
//   docker build -t tb-lite/bwa-picard:3.4.0 -f containers/dockerfiles/bwa-picard.Dockerfile .
// ============================================================================
process {

withName: 'ANN_TABLE:POST_PROCESS_TABLE' {
      container = "${params.sifDir}/ann_table.sif"
      containerOptions = "--env _JAVA_OPTIONS=\"-Xlog:perf+memops=off\""
  }


    withName: 'ANN_TABLE:SNPEFF_ANN' {
      container = "${params.sifDir}/snpeff_table.sif"
      containerOptions = "--env _JAVA_OPTIONS=\"-Xlog:perf+memops=off\""
  }

  withName: 'ANN_TABLE:MERGE' {
      container = "${params.sifDir}/snpeff_table.sif"
  }
  withName: 'ANN_TABLE:MAKE_TABLE' {
      container = "${params.sifDir}/snpeff_table.sif"
  }
    withName: 'TRIMMING:REPAIR_READS' {
      container = "${params.sifDir}/bbmap_38.96.sif"
  }

  withName: 'QC:FASTQC' {
      container = "${params.sifDir}/fastqc_latest.sif"
  }

  withName: 'TRIMMING:FASTP' {
      container = "${params.sifDir}/fastp_0.24.1.sif"
  }

  withName: 'MAPPING:BWA_PICARD' {
      container = "${params.sifDir}/bwa-picard.sif"
  }

  withName: 'FILTER:RUN_MAP_STATS' {
      container = "${params.sifDir}/picard_3.4.0.sif"
  }

  withName: 'FILTER:TB_MIX' {
      container = "${params.sifDir}/tb_mix.sif"
  }



  withName: 'FILTER:RUN_SAMTOOLS_STATS' {
      container = "${params.sifDir}/bwa-picard.sif"
  }

  withName: 'CALLVAR:BCFTOOLS_STATS' {
      container = "${params.sifDir}/bcftools.1.22.sif"
  }

  withName: 'CALLVAR:BCFTOOLS_CALL_VARIANTS' {
      container = "${params.sifDir}/gatk.sif"
  }

  withName: 'CALLVAR:FREEBAYES_CALL_VARIANTS' {
      container = "${params.sifDir}/freebayes.sif"
  }
    withName: 'CALLVAR:GATK_CALL_VARIANTS' {
        container = "${params.sifDir}/gatk.sif"
    }

  withName: 'GENOTYPE:SPOTYPING' {
      container = "${params.sifDir}/spotyping.sif"
  }

   withName: 'GENOTYPE:MOSDEPTH' {
      container = "${params.sifDir}/mosdpt.sif"
  }

  withName: 'GENOTYPE:RD' {
      container = "${params.sifDir}/rd.sif"
  }

  withName: 'GENOTYPE:TBLG' {
      container = "${params.sifDir}/tblg.sif"
  }

  withName: 'CALLVAR:SNPEFF_ANNOTATE_VCF' {
        container = "${params.sifDir}/snpeff.sif"
        containerOptions = "--env _JAVA_OPTIONS=\"-Xlog:perf+memops=off\""
    }

  withName: 'CALLVAR:RENAME_CHR' {
        container = "${params.sifDir}/bcftools.1.22.sif"
    }

    withName: 'GENOTYPE:TB_PROFILER_DR' {
        container    = "${params.sifDir}/tbp.sif"
        containerOptions = "--env _JAVA_OPTIONS=\"-Xlog:perf+memops=off\""
    }

  withName: 'GENOTYPE:ISMAPPER' {
        container = "${params.sifDir}/ismap.sif"
    }

    withName: 'REPORTS:MULTIQC' {
        container = "${params.sifDir}/multiqc_v1.30.sif"
    }
    withName: 'REPORTS:TB_PLATFORM_TABLES' {
        container = "${params.sifDir}/tb_platform_tables.sif"
    }
    withName: 'REPORTS:FINAL_TABLE' {
        container = "${params.sifDir}/build_table.sif"
    }
    withName: 'MAPPING:BWA_INDEX' {
        container = "${params.sifDir}/bwa-picard.sif"
    }


}