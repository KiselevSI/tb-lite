// nextflow.config


params {
    outdir        = "./results"
    reference     = "${baseDir}/assets/h37rv.fa"
    mode          = 'link'                    // link | copy
    rd_db         = "${baseDir}/assets/rd/RD.bed"
    is6110        = "${baseDir}/assets/ismap/is6110.fasta"
    ref_gbk       = "${baseDir}/assets/ismap/h37rv.gbk"
    chr_name      = "${baseDir}/assets/chr_name/chr.txt"
    levels        = "${baseDir}/assets/tbmix/levels.tsv"
    feature_table = "${baseDir}/assets/vcf2table/feature_table.tsv"
    multiqc       = "${baseDir}/assets/multiqc/multiqc_config.yaml"
    gff         = "/home/zerg/Downloads/Mycobacterium_tuberculosis_gca_001318445.6505_5_10.62.gff3"
    snpeff_db    = "Mycobacterium_tuberculosis_h37rv"
    gbk         = "${baseDir}/assets/h37rv.gb"

    h37rv_feature_table = "${baseDir}/assets/SNPEFF_ANNOTATION/h37rv_feature_table.txt"

    min_align_pct = 80
    min_mean_cov  = 10
    min_median    = 10

    samples       = "run.csv"
    sifDir        = ( System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${baseDir}/containers" )
}


profiles {
    local {
        executor {
            name      = 'local'
            cpus    = 12
        }
        process {

            withLabel: solo_cpu {
                maxForks    = 12
                cpus        = 1
            }
            withLabel: multi_cpu {
                maxForks    = 6
                cpus        = 4
            }
            withLabel: small_mem {
                memory = 4.GB
            }

            withLabel: medium_mem {
                memory = 6.GB
            }

            withLabel: big_mem {
                memory = 8.GB
            }
        }
    }

    k8s {
        executor {
            name = 'k8s'
        }
        process {
            cpus = 3
            withLabel: small_mem {
                memory = 1.GB
            }
            withLabel: medium_mem {
                memory = 2.GB
            }
            withLabel: big_mem {
                memory = 4.GB
            }
        }
    }
}



docker {
    enabled   = true
    runOptions = '-u $(id -u):$(id -g)'
}



process {

    // --- ANN_TABLE ---
    withName: 'ANN_TABLE:POST_PROCESS_TABLE' {
        container = 'tb-lite/ann-table:1.0'                    // *кастомный
        containerOptions = '-e _JAVA_OPTIONS="-Xlog:perf+memops=off"'
    }
    withName: 'ANN_TABLE:SNPEFF_ANN' {
        container = 'tb-lite/snpeff-table:1.0'                 // *кастомный
        containerOptions = '-e _JAVA_OPTIONS="-Xlog:perf+memops=off"'
    }
    withName: 'ANN_TABLE:MERGE' {
        container = 'tb-lite/snpeff-table:1.0'                 // *кастомный
    }
    withName: 'ANN_TABLE:MAKE_TABLE' {
        container = 'tb-lite/snpeff-table:1.0'                 // *кастомный
    }

    // --- TRIMMING ---
    withName: 'TRIMMING:REPAIR_READS' {
        container = 'staphb/bbtools:38.96'                     // Docker Hub
    }
    withName: 'TRIMMING:FASTP' {
        container = 'staphb/fastp:1.1.0'                      // Docker Hub
    }

    // --- QC ---
    withName: 'QC:FASTQC' {
        container = 'staphb/fastqc:0.12.1'                     // Docker Hub
    }

    // --- MAPPING ---
    withName: 'MAPPING:BWA_PICARD' {
        container = 'tb-lite/bwa-picard:3.4.0'                 // *кастомный
    }
    withName: 'MAPPING:BWA_INDEX' {
        container = 'tb-lite/bwa-picard:3.4.0'                 // *кастомный
    }

    // --- FILTER ---
    withName: 'FILTER:RUN_MAP_STATS' {
        container = 'broadinstitute/picard:3.4.0'              // Docker Hub
    }
    withName: 'FILTER:TB_MIX' {
        container = 'tb-lite/tb-mix:1.0'                       // *кастомный
    }
    withName: 'FILTER:RUN_SAMTOOLS_STATS' {
        container = 'tb-lite/bwa-picard:3.4.0'                 // *кастомный
    }

    // --- VARIANT CALLING ---
    withName: 'CALLVAR:BCFTOOLS_STATS' {
        container = 'staphb/bcftools:1.22'                     // Docker Hub
    }
    withName: 'CALLVAR:BCFTOOLS_CALL_VARIANTS' {
        container = 'broadinstitute/gatk:latest'               // Docker Hub
    }
    withName: 'CALLVAR:FREEBAYES_CALL_VARIANTS' {
        container = 'tb-lite/freebayes:1.3.10'                 // *кастомный
    }
    withName: 'CALLVAR:GATK_CALL_VARIANTS' {
        container = 'broadinstitute/gatk:latest'               // Docker Hub
    }
    withName: 'CALLVAR:SNPEFF_ANNOTATE_VCF' {
        container = 'tb-lite/snpeff:5.2'                       // *кастомный
        containerOptions = '-e _JAVA_OPTIONS="-Xlog:perf+memops=off"'
    }
    withName: 'CALLVAR:RENAME_CHR' {
        container = 'staphb/bcftools:1.22'                     // Docker Hub
    }

    // --- GENOTYPING ---
    withName: 'GENOTYPE:SPOTYPING' {
        container = 'tb-lite/spotyping:2.0'                    // *кастомный
    }
    withName: 'GENOTYPE:MOSDEPTH' {
        container = 'tb-lite/mosdepth:0.3.11'                  // *кастомный
    }
    withName: 'GENOTYPE:RD' {
        container = 'tb-lite/rd-scanner:1.0'                   // *кастомный
    }
    withName: 'GENOTYPE:TBLG' {
        container = 'tb-lite/tblg:1.0'                         // *кастомный
    }
    withName: 'GENOTYPE:TB_PROFILER_DR' {
        container =  'staphb/tbprofiler:6.6.6'//'tb-lite/tbprofiler:6.6.5'                 // *кастомный
        containerOptions = '-e _JAVA_OPTIONS="-Xlog:perf+memops=off"'
    }
    withName: 'GENOTYPE:ISMAPPER' {
        container = 'tb-lite/ismap:1.0'                        // *кастомный
    }

    // --- REPORTS ---
    withName: 'REPORTS:MULTIQC' {
        container = 'multiqc/multiqc:v1.30'                    // Docker Hub
    }
    withName: 'REPORTS:TB_PLATFORM_TABLES' {
        container = 'tb-lite/tb-platform-tables:1.0'          // *кастомный
    }
    withName: 'REPORTS:FINAL_TABLE' {
        container = 'tb-lite/build-table:1.0'                  // *кастомный
    }
}
