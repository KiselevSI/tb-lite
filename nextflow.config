// nextflow.config


params {
    outdir        = "./results"
    reference     = "assets/h37rv.fa"
    mode          = 'link'                    // link | copy
    rd_db         = "assets/rd/RD.bed"
    is6110        = "assets/ismap/is6110.fasta"
    ref_gbk       = "assets/ismap/h37rv.gbk"
    chr_name      = "assets/chr_name/chr.txt"
    levels        = "assets/tbmix/levels.tsv"
    feature_table = "assets/vcf2table/feature_table.tsv"
    multiqc       = "assets/multiqc/multiqc_config.yaml"

    min_align_pct = 80
    min_mean_cov  = 10
    min_median    = 10

    samples       = "run.csv"
    sifDir        = "containers"              // каталог с .sif-образами
}


profiles {
    local {
        executor {
            name      = 'local'
            cpus      = 2
            queueSize = 6
        }
    }

    slurm {
        executor {
            name      = 'slurm'
            queueSize = 10
        }

        // sensible defaults for a 128‑thread cluster
        process {
            queue   = 'standard'   // SLURM partition (edit if needed)
            time    = '6h'        // default wall time
            cpus    = 4            // default CPUs per task
        }
    }
}

// включаем Apptainer / Singularity и запрещаем авто-скачивание
singularity {
    enabled   = true
    autoMounts = true
}


process {

  withName: 'QC:FASTQC' {
      container = "${params.sifDir}/fastqc_latest.sif"
  }

  withName: 'TRIMMING:FASTP' {
      container = "${params.sifDir}/fastp_0.24.1.sif"
      memory    = '8 GB'
  }

  withName: 'MAPPING:BWA_PICARD' {
      container = "${params.sifDir}/bwa-picard.sif"
      memory = '8 GB'
  }

  withName: 'FILTER:RUN_MAP_STATS' {
      container = "${params.sifDir}/picard_latest.sif"
  }

  withName: 'FILTER:TB_MIX' {
      container = "${params.sifDir}/tb_mix.sif"
  }



  withName: 'FILTER:RUN_SAMTOOLS_STATS' {
      container = "${params.sifDir}/mapping.sif"
  }

  withName: 'CALLVAR:BCFTOOLS_STATS' {
      container = "${params.sifDir}/bcftools.1.22.sif"
      memory = '8 GB'
  }

  withName: 'CALLVAR:BCFTOOLS_CALL_VARIANTS' {
      container = "${params.sifDir}/bcftools.1.22.sif"
      memory = '8 GB'
  }

  withName: 'GENOTYPE:SPOTYPING' {
      container = "${params.sifDir}/spotyping.sif"
  }

   withName: 'GENOTYPE:MOSDEPTH' {
      container = "${params.sifDir}/mosd.sif"
  }

  withName: 'GENOTYPE:RD' {
      container = "${params.sifDir}/rd.sif"
  }

  withName: 'GENOTYPE:TBLG' {
      container = "${params.sifDir}/tblg.sif"
  }

  withName: 'CALLVAR:SNPEFF_ANNOTATE_VCF' {
        container = "${params.sifDir}/snpeff.sif"
    }
  
  withName: 'CALLVAR:RENAME_CHR' {
        container = "${params.sifDir}/bcftools.1.22.sif"
    }

    withName: 'GENOTYPE:TB_PROFILER_DR' {
        container    = "${params.sifDir}/tbprofiler.sif"
        containerOptions = "--env _JAVA_OPTIONS=\"-Xlog:perf+memops=off\""
        memory = '8 GB'
    }

  withName: 'GENOTYPE:ISMAPPER' {
        container = "${params.sifDir}/ismap.sif"
        memory = '8 GB'
    }
    
    withName: 'REPORTS:MULTIQC' {
        container = "${params.sifDir}/multiqc_v1.30.sif"
    }
    withName: 'REPORTS:FINAL_TABLE' {
        container = "${params.sifDir}/build_table.sif"
    }
    withName: 'MAPPING:BWA_INDEX' {
        container = "${params.sifDir}/bwa-picard.sif"
    }

    //VCF2TABLE
    withName: 'VCF2TABLE:MERGE_VCF' {
        container = "${params.sifDir}/vcf2table.sif"
    }
    withName: 'VCF2TABLE:ANNOTATION_TABLE' {
        container = "${params.sifDir}/vcf2table.sif"
    }
    withName: 'VCF2TABLE:RENAME_CHR' {
        container = "${params.sifDir}/bcftools.1.22.sif"
    }
    withName: 'VCF2TABLE:ANNOTATION_VCFS' {
        container = "${params.sifDir}/snpeff.sif"
    }

}


