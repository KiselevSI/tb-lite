// conf/base.config — Process resource defaults

process {
    cpus   = 1
    memory = 4.GB

    withLabel: process_single {
        cpus = 1
        memory = 4.GB
        maxForks = 12
    }
    withLabel: process_low {
        cpus = 2
        memory = 6.GB
        maxForks = 12
    }
    withLabel: process_medium {
        cpus = 6
        memory = 8.GB
        maxForks = 6
    }
    withLabel: process_high {
        cpus = 6
        memory = 8.GB
        maxForks = 2
    }
}
