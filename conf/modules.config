// conf/modules.config — Per-process container and options

process {

    // --- TRIMMING ---
    withName: 'FASTP' {
        ext.args = '--trim_poly_g'
        publishDir = [
            path: { "${params.outdir}/fastp/${meta.id}" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- QC ---
    withName: 'FASTQC' {
        publishDir = [
            path: { "${params.outdir}/fastqc/${meta.id}" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- MAPPING ---
    withName: 'BWA_INDEX' {
        memory = { 4.GB * task.attempt }
    }
    withName: 'BWA_MEM' {
        ext.args = { "-M -R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.id}\\tPL:ILLUMINA'" }
    }
    withName: 'PICARD_MARKDUPLICATES' {
        ext.args = '--ASSUME_SORTED true --VALIDATION_STRINGENCY SILENT --CREATE_INDEX true'
        ext.prefix = { "${meta.id}.dedup" }
        publishDir = [
            path: { "${params.outdir}/mapped/${meta.id}" },
            mode: params.mode,
            pattern: '*.bam'
        ]
    }

    // --- FILTER ---
    withName: 'TB_MIX' {
        container = 'tb-lite/tb-mix:1.0'
    }
    withName: 'PICARD_COLLECTWGSMETRICS' {
        ext.args = '--COVERAGE_CAP 100000 --COUNT_UNPAIRED true'
    }
    withName: 'PICARD_COLLECTALIGNMENTSUMMARYMETRICS' {
        ext.args = ''
    }

    // --- VARIANT CALLING ---
    withName: 'FREEBAYES' {
        // Docker cannot resolve the nf-core shorthand biocontainers/freebayes:... via Docker Hub.
        // Use the official fully-qualified Biocontainers image on Quay while keeping the nf-core module.
        container = 'quay.io/biocontainers/freebayes:1.3.10--hbefcdb2_0'
        cpus = 4
        memory = { 8.GB * task.attempt }
        ext.args = '--ploidy 1 --min-mapping-quality 20 --min-base-quality 20 --min-coverage 10 --min-alternate-fraction 0.80 --max-complex-gap 3'
        ext.prefix = { "${meta.id}.freebayes" }
    }
    withName: 'BCFTOOLS_INDEX' {
        ext.args = '-t'
    }
    withName: 'BCFTOOLS_NORM' {
        ext.args = '-Oz --write-index=tbi'
        ext.prefix = { "${meta.id}.norm" }
    }
    withName: 'BCFTOOLS_VIEW' {
        ext.args = "-Oz -i 'QUAL>=10 && INFO/DP>=10' --write-index=tbi"
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/vcf/${meta.id}" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'BCFTOOLS_STATS' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/stats/bcftools" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'BCFTOOLS_ANNOTATE' {
        ext.args = '-Oz --write-index=tbi'
        ext.prefix = { "${meta.id}.renamed_chromosome" }
    }
    withName: 'SNPEFF_SNPEFF' {
        containerOptions = '-e _JAVA_OPTIONS="-Xlog:perf+memops=off"'
        ext.args = '-noLog -nodownload -no-downstream -no-upstream -no-utr'
        ext.prefix = { "${meta.id}.annotated" }
        publishDir = [
            path: { "${params.outdir}/annotate_vcf/${meta.id}" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'COUNT_VARIANTS' {
        container = 'community.wave.seqera.io/library/bcftools_htslib:1.23.1--9f08ec665533d64a'
    }
    withName: 'ANN_BCFTOOLS_MERGE' {
        ext.args = '-Oz --write-index=tbi'
        ext.prefix = 'cohort.merge'
        publishDir = [
            path: { "${params.outdir}/snpeff" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'ANN_SNPEFF' {
        containerOptions = '-e _JAVA_OPTIONS="-Xlog:perf+memops=off"'
        ext.args = '-noLog -nodownload -no-downstream -no-upstream -no-utr'
        ext.prefix = 'cohort'
        publishDir = [
            path: { "${params.outdir}/snpeff" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'ANN_BCFTOOLS_VIEW' {
        ext.args = '-Oz --write-index=tbi'
        ext.prefix = 'cohort.ann'
        publishDir = [
            path: { "${params.outdir}/snpeff" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'MAKE_TABLE' {
        container = 'tb-lite/ann-table:1.0'
    }
    withName: 'POST_PROCESS_TABLE' {
        container = 'tb-lite/ann-table:1.0'
    }

    // --- SRA INPUT ---
    // Docker cannot resolve the nf-core shorthand biocontainers/sra-tools:... via Docker Hub.
    // Use the official fully-qualified Biocontainers image on Quay while keeping the nf-core modules.
    withName: 'CUSTOM_SRATOOLSNCBISETTINGS' {
        container = 'quay.io/biocontainers/sra-tools:3.2.1--h4304569_1'
    }
    withName: 'SRATOOLS_PREFETCH' {
        container = 'quay.io/biocontainers/sra-tools:3.2.1--h4304569_1'
    }
    withName: 'SRA_DETECT_LAYOUT' {
        container = 'community.wave.seqera.io/library/sra-tools_pigz:4a694d823f6f7fcf'
    }
    withName: 'SRATOOLS_FASTERQDUMP' {
        ext.args = '--split-files --skip-technical'
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/sra_fastq/${meta.id}" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- GENOTYPING ---
    withName: 'SPOTYPING' {
        container = 'tb-lite/spotyping:2.0'
    }
    withName: 'MOSDEPTH' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/stats/mosdepth/${meta.id}" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'RD' {
        container = 'tb-lite/rd-scanner:1.0'
    }
    withName: 'TBLG' {
        container = 'tb-lite/tblg:1.0'
    }
    withName: 'TB_PROFILER_DR' {
        container = 'staphb/tbprofiler:6.6.6'
        containerOptions = '-e _JAVA_OPTIONS="-Xlog:perf+memops=off"'
    }
    withName: 'ISMAPPER' {
        // Docker cannot resolve the nf-core shorthand biocontainers/ismapper:... via Docker Hub.
        // Use the official fully-qualified Biocontainers image on Quay while keeping the nf-core module.
        container = 'quay.io/biocontainers/ismapper:2.0.2--pyhdfd78af_1'
        ext.args = '--bam'
        publishDir = [
            path: { "${params.outdir}/is6110/paired/${meta.id}" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- REPORTS ---
    withName: 'MULTIQC' {
        ext.args = "--title 'TB-Lite QC'"
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'TB_PLATFORM_TABLES' {
        container = 'tb-lite/tb-platform-tables:1.1'
    }
    withName: 'FINAL_TABLE' {
        container = 'tb-lite/build-table:1.1'
    }

    // --- KRAKEN ---
    withName: 'KRAKEN2_KRAKEN2' {
        ext.args = '--confidence 0.05 --use-names'
        publishDir = [
            path: { "${params.outdir}/kraken2/kraken2/${meta.id}" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'BRACKEN_BRACKEN' {
        ext.args = '-r 50 -l S -t 1'
        publishDir = [
            path: { "${params.outdir}/kraken2/bracken/${meta.id}" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'BRACKEN_ADD_UNCLASSIFIED' {
        publishDir = [
            path: { "${params.outdir}/kraken2/bracken/${meta.id}" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'BRACKEN_COMBINEBRACKENOUTPUTS' {
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
