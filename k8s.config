// k8s.config
// Конфигурация для запуска пайплайна с Nextflow K8s executor.
// Каждый шаг пайплайна создаёт отдельный K8s Pod.
//
// Использование:
//   nextflow run main.nf -profile k8s -c k8s.config

// Плагин K8s executor
plugins {
    id 'nf-k8s'
}

// Отключаем Singularity
singularity {
    enabled = false
}

// Docker-образы используются K8s executor для контейнеров в подах
docker {
    enabled = true
}

// Настройки K8s executor
k8s {
    storageClaimName = 'tb-runs-pvc'
    storageMountPath = '/mnt/data1/tb-lite-runs'
    namespace = 'tb-platform'
    serviceAccount = 'nextflow-sa'
    computeResourceType = 'Job'
    pullPolicy = 'IfNotPresent'
}

// ============================================================================
// Docker-образы для каждого процесса
// ============================================================================

process {

    // --- ANN_TABLE ---
    withName: 'ANN_TABLE:POST_PROCESS_TABLE' {
        container = 'tb-lite/ann-table:1.0'
        pod = [[env: '_JAVA_OPTIONS', value: '-Xlog:perf+memops=off']]
    }
    withName: 'ANN_TABLE:SNPEFF_ANN' {
        container = 'tb-lite/snpeff-table:1.0'
        pod = [[env: '_JAVA_OPTIONS', value: '-Xlog:perf+memops=off']]
    }
    withName: 'ANN_TABLE:MERGE' {
        container = 'tb-lite/snpeff-table:1.0'
    }
    withName: 'ANN_TABLE:MAKE_TABLE' {
        container = 'tb-lite/snpeff-table:1.0'
    }

    // --- TRIMMING ---
    withName: 'TRIMMING:REPAIR_READS' {
        container = 'staphb/bbtools:38.96'
    }
    withName: 'TRIMMING:FASTP' {
        container = 'staphb/fastp:1.1.0'
    }

    // --- QC ---
    withName: 'QC:FASTQC' {
        container = 'staphb/fastqc:0.12.1'
    }

    // --- MAPPING ---
    withName: 'MAPPING:BWA_PICARD' {
        container = 'tb-lite/bwa-picard:3.4.0'
    }
    withName: 'MAPPING:BWA_INDEX' {
        container = 'tb-lite/bwa-picard:3.4.0'
    }

    // --- FILTER ---
    withName: 'FILTER:RUN_MAP_STATS' {
        container = 'broadinstitute/picard:3.4.0'
    }
    withName: 'FILTER:TB_MIX' {
        container = 'tb-lite/tb-mix:1.0'
    }
    withName: 'FILTER:RUN_SAMTOOLS_STATS' {
        container = 'tb-lite/bwa-picard:3.4.0'
    }

    // --- VARIANT CALLING ---
    withName: 'CALLVAR:BCFTOOLS_STATS' {
        container = 'staphb/bcftools:1.22'
    }
    withName: 'CALLVAR:BCFTOOLS_CALL_VARIANTS' {
        container = 'broadinstitute/gatk:latest'
    }
    withName: 'CALLVAR:FREEBAYES_CALL_VARIANTS' {
        container = 'tb-lite/freebayes:1.3.10'
    }
    withName: 'CALLVAR:GATK_CALL_VARIANTS' {
        container = 'broadinstitute/gatk:latest'
    }
    withName: 'CALLVAR:SNPEFF_ANNOTATE_VCF' {
        container = 'tb-lite/snpeff:5.2'
        pod = [[env: '_JAVA_OPTIONS', value: '-Xlog:perf+memops=off']]
    }
    withName: 'CALLVAR:RENAME_CHR' {
        container = 'staphb/bcftools:1.22'
    }

    // --- GENOTYPING ---
    withName: 'GENOTYPE:SPOTYPING' {
        container = 'tb-lite/spotyping:2.0'
    }
    withName: 'GENOTYPE:MOSDEPTH' {
        container = 'tb-lite/mosdepth:0.3.11'
    }
    withName: 'GENOTYPE:RD' {
        container = 'tb-lite/rd-scanner:1.0'
    }
    withName: 'GENOTYPE:TBLG' {
        container = 'tb-lite/tblg:1.0'
    }
    withName: 'GENOTYPE:TB_PROFILER_DR' {
        container = 'staphb/tbprofiler:6.6.6'
        pod = [[env: '_JAVA_OPTIONS', value: '-Xlog:perf+memops=off']]
    }
    withName: 'GENOTYPE:ISMAPPER' {
        container = 'tb-lite/ismap:1.0'
    }

    // --- REPORTS ---
    withName: 'REPORTS:MULTIQC' {
        container = 'multiqc/multiqc:v1.30'
    }
    withName: 'REPORTS:TB_PLATFORM_TABLES' {
        container = 'tb-lite/tb-platform-tables:1.0'
    }
    withName: 'REPORTS:FINAL_TABLE' {
        container = 'tb-lite/build-table:1.0'
    }
}
