// k8s.config
// Использование:
//   nextflow run main.nf -profile docker -c k8s.config
//
// Этот конфиг меняет только executor и Kubernetes-specific настройки.
// Контейнерный runtime остаётся Docker через -profile docker.

plugins {
    id 'nf-k8s'
}

docker {
    enabled = true
}

singularity {
    enabled = false
}

conda {
    enabled = false
}

executor {
    name = 'k8s'
}

process {
    cpus = 3
}

k8s {
    storageClaimName   = 'tb-runs-pvc'
    storageMountPath   = '/mnt/data1/tb-lite-runs'
    namespace          = 'tb-platform'
    serviceAccount     = 'nextflow-sa'
    computeResourceType = 'Job'
    pullPolicy         = 'IfNotPresent'
}
