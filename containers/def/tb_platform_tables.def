Bootstrap: docker
From: python:3.12-slim


# Скрипты пайплайн запускает из bin/ через ${projectDir}; копии внутри образа
# нужны только для ручных запусков, поэтому берём их из того же bin/.
%files
    bin/filter_tbmix.py         /opt/filter_tbmix.py
    bin/build_metrics_table.py  /opt/build_metrics_table.py
    bin/build_general_table.py  /opt/build_general_table.py
    bin/build_is6110_tables.py  /opt/build_is6110_tables.py
    bin/build_spoligo_table.py  /opt/build_spoligo_table.py
    bin/concat_tables.py        /opt/concat_tables.py
    bin/profiler_parser.py      /opt/profiler_parser.py

%post
    set -e

    apt-get update \
      && apt-get install -y --no-install-recommends \
         procps coreutils gawk grep sed findutils \
      && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir pandas xlsxwriter openpyxl biopython

    for script in filter_tbmix build_metrics_table build_general_table \
                  build_is6110_tables build_spoligo_table concat_tables \
                  profiler_parser; do
        chmod +x "/opt/${script}.py"
        ln -s "/opt/${script}.py" "/usr/local/bin/${script}.py"
    done


%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt:$PATH
    export PYTHONUNBUFFERED=1
