Bootstrap: docker
From: continuumio/miniconda3

%files
    /home/zerg/git/tb-lite/ref/h37rv.fa /ref/h37rv.fa


%post
    apt-get update && apt-get install -y wget unzip bzip2 ca-certificates \
        curl openjdk-17-jre-headless tabix

    conda config --add channels defaults
    conda config --add channels bioconda
    conda config --add channels conda-forge

    conda create -n snpeff_env snpeff=5.2 openjdk -y
    
    conda clean -afy

    echo ". /opt/conda/etc/profile.d/conda.sh" >> $SINGULARITY_ENVIRONMENT
    echo "conda activate snpeff_env" >> $SINGULARITY_ENVIRONMENT

    . /opt/conda/etc/profile.d/conda.sh
    conda activate snpeff_env

    snpEff download -v Mycobacterium_tuberculosis_h37rv

%runscript
    # при запуске среды уже активирована, просто выполняем snpEff
    snpEff "$@"