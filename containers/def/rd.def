Bootstrap: docker
From: python:3.11-slim    # при желании поменяйте версию Python


%files
    bin/rd_scan.py  /opt/rd_scan.py

%post
    set -e

    # Обновляем репозитории и ставим минимальный набор системных пакетов
    apt-get update \
      && apt-get install -y --no-install-recommends \
         procps \
      && rm -rf /var/lib/apt/lists/*

    # rd_scan.py использует только стандартную библиотеку Python.
    # Делаем скрипт исполняемым и добавляем удобный alias
    chmod +x /opt/rd_scan.py
    ln -s /opt/rd_scan.py /usr/local/bin/rd_scan.py

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1      # мгновенный вывод в консоль
