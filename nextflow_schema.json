{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/tb-lite/main/nextflow_schema.json",
    "title": "TB-Lite pipeline parameters",
    "description": "Mycobacterium tuberculosis WGS analysis pipeline",
    "type": "object",
    "definitions": {
        "input_output_options": {
            "title": "Input / output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "properties": {
                "input": {
                    "type": "string",
                    "description": "Path to FASTQ samplesheet CSV with columns sample,fastq_1,fastq_2. FASTQ paths must be *.fastq.gz or *.fq.gz."
                },
                "samples": {
                    "type": "string",
                    "description": "Deprecated alias for --input."
                },
                "sra_ids": {
                    "type": "string",
                    "description": "Path to text file with one SRA accession per line."
                },
                "outdir": {
                    "type": "string",
                    "default": "./results",
                    "description": "Output directory."
                },
                "mode": {
                    "type": "string",
                    "default": "copy",
                    "description": "publishDir mode.",
                    "enum": ["copy", "link", "move", "symlink", "rellink"]
                }
            }
        },
        "reference_genome": {
            "title": "Reference and annotation options",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "properties": {
                "reference": {
                    "type": "string",
                    "description": "Reference genome FASTA."
                },
                "gff": {
                    "type": "string",
                    "description": "Optional GFF3 annotation file."
                },
                "gbk": {
                    "type": "string",
                    "description": "Reference GenBank file."
                },
                "snpeff_db": {
                    "type": "string",
                    "default": "Mycobacterium_tuberculosis_h37rv",
                    "description": "SnpEff database name."
                },
                "snpeff_data_dir": {
                    "type": "string",
                    "description": "Path to SnpEff data directory mounted into the container."
                },
                "chr_name": {
                    "type": "string",
                    "description": "Chromosome name mapping file."
                }
            }
        },
        "genotyping_options": {
            "title": "Genotyping options",
            "type": "object",
            "fa_icon": "fas fa-microscope",
            "properties": {
                "rd_db": {
                    "type": "string",
                    "description": "Region of Difference BED file."
                },
                "is6110": {
                    "type": "string",
                    "description": "IS6110 FASTA for ISMapper."
                },
                "ref_gbk": {
                    "type": "string",
                    "description": "Reference GenBank file for ISMapper."
                },
                "levels": {
                    "type": "string",
                    "description": "TB-Mix levels TSV."
                }
            }
        },
        "annotation_options": {
            "title": "Annotation and tables",
            "type": "object",
            "fa_icon": "fas fa-tags",
            "properties": {
                "feature_table": {
                    "type": "string",
                    "description": "Feature table for VCF-to-table conversion."
                },
                "h37rv_feature_table": {
                    "type": "string",
                    "description": "Feature table for H37Rv SnpEff annotation."
                }
            }
        },
        "filtering_options": {
            "title": "Filtering thresholds",
            "type": "object",
            "fa_icon": "fas fa-filter",
            "properties": {
                "min_align_pct": {
                    "type": "integer",
                    "default": 90,
                    "description": "Mapped reads percentage threshold. Samples pass when reads_mapped_pct is greater than this value."
                },
                "min_mean_cov": {
                    "type": "integer",
                    "default": 10,
                    "description": "Minimum mean coverage."
                },
                "min_median": {
                    "type": "integer",
                    "default": 30,
                    "description": "Minimum median coverage."
                }
            }
        },
        "kraken_options": {
            "title": "Kraken / Bracken",
            "type": "object",
            "fa_icon": "fas fa-bacteria",
            "properties": {
                "kraken2_db": {
                    "type": "string",
                    "description": "Kraken2 database path."
                },
                "skip_kraken": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip Kraken2/Bracken branch."
                }
            }
        },
        "reporting_options": {
            "title": "Reporting options",
            "type": "object",
            "fa_icon": "fas fa-chart-bar",
            "properties": {
                "skip_reports": {
                    "type": "boolean",
                    "default": false,
                    "description": "Deprecated alias for skipping both MultiQC and final reports."
                },
                "skip_multiqc": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip MultiQC generation."
                },
                "skip_final_reports": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip final TB reports."
                },
                "skip_snp_matrix": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip cohort SNP matrix generation (ANN_TABLE)."
                },
                "skip_qc": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip FastQC."
                },
                "multiqc": {
                    "type": "string",
                    "description": "Deprecated alias for --multiqc_config."
                },
                "multiqc_config": {
                    "type": "string",
                    "description": "Path to MultiQC configuration YAML."
                }
            }
        },
        "container_options": {
            "title": "Container / runtime options",
            "type": "object",
            "fa_icon": "fas fa-box",
            "properties": {
                "sifDir": {
                    "type": "string",
                    "description": "Directory for Singularity SIF images."
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-cogs",
            "properties": {
                "help": {
                    "type": "boolean",
                    "default": false,
                    "description": "Display help text.",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        { "$ref": "#/definitions/input_output_options" },
        { "$ref": "#/definitions/reference_genome" },
        { "$ref": "#/definitions/genotyping_options" },
        { "$ref": "#/definitions/annotation_options" },
        { "$ref": "#/definitions/filtering_options" },
        { "$ref": "#/definitions/kraken_options" },
        { "$ref": "#/definitions/reporting_options" },
        { "$ref": "#/definitions/container_options" },
        { "$ref": "#/definitions/generic_options" }
    ]
}
